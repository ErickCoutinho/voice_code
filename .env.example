# Copie este arquivo para C:\Users\<usuário>\.voice-code\.env
# Variáveis de ambiente definidas no sistema têm prioridade sobre este arquivo.

# Voz do edge-tts usada na leitura das respostas (padrão: pt-BR-AntonioNeural).
TTS_VOICE=pt-BR-AntonioNeural

# Velocidade da fala, no formato +25% ou -10% (padrão: +25%).
TTS_RATE=+25%

# Volume do microfone (RMS, entre 0 e 1) a partir do qual a fala é interrompida
# (padrão: 0.02). Aumente se a fala parar sozinha; diminua se não parar quando você fala.
VOICE_INTERRUPT_THRESHOLD=0.02
